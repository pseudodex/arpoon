<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arpoon.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- ── Theme v6: native Windows 11 / Fluent Dark palette. Neutrals
             are a genuine slate-blue, not a near-neutral gray with a hint
             of tint — the hue itself is shifted toward blue so it reads as
             part of the same family as the accent instead of a flat gray
             sitting underneath it. Every accent (blue, red, success,
             warning) is desaturated/darkened from the raw Fluent swatch —
             muted enough to sit quietly on that background instead of
             popping off it. ── -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15191E"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C2127"/>
        <SolidColorBrush x:Key="CardBackgroundElevatedBrush" Color="#222832"/>
        <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2E3540"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E232A"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF1F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7AFBB"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#707883"/>

        <!-- Accent: Windows blue, muted but not washed out — the pastel
             pass (S32/L48) read as lifeless/flat, so this sits between
             that and the earlier, more saturated muted blue (S44/L45):
             enough saturation to still look like a color, not a tint. -->
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4A7AA4"/>
        <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#6693BA"/>
        <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#3A5F80"/>
        <SolidColorBrush x:Key="AccentPrimaryBgBrush" Color="#18222C"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#222832"/>
        <SolidColorBrush x:Key="SelectionHoverBrush" Color="#2E3540"/>

        <!-- Danger: a muted terracotta, used for the Blocked stat, the
             Spoof action, and the block-list checkbox — genuine negative
             state, not a darker tint of blue, held to the same "muted, not
             pastel" level as the blue. The only non-blue accent in the
             app, kept to that one meaning. -->
        <SolidColorBrush x:Key="AccentDangerBrush" Color="#B05345"/>
        <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="#C37165"/>
        <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="#8C4236"/>
        <SolidColorBrush x:Key="AccentDangerBgBrush" Color="#271D1B"/>

        <!-- Fonts: Inter everywhere, but SF Pro/SF Mono take priority when
             actually present (real system fonts on macOS only - elsewhere
             Avalonia just skips straight to the next name in the list).
             JetBrains Mono is bundled (Assets/Fonts) as the non-Apple
             monospace fallback, used for IP/MAC/speed columns. -->
        <FontFamily x:Key="PrimaryFontFamily">SF Pro Text, Inter, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="MonospaceFontFamily">SF Mono, avares://Arpoon/Assets/Fonts#JetBrains Mono, Cascadia Code, Consolas, monospace</FontFamily>

        <!-- ── Vector PathIcon Geometries ──
             Windows 11 preview build: swapped from the hand-drawn outline
             set to Microsoft's Fluent UI System Icons (Segoe Fluent Icons'
             open-source counterpart, MIT licensed), filled 24px variants,
             so the glyphs match the native Windows 11 icon language. Path
             data is used as-is: Avalonia's StreamGeometry mini-language is
             SVG path syntax. ── -->
        <StreamGeometry x:Key="IconEye">M12 9A4 4 0 1 0 12 17A4 4 0 0 0 12 9M12 5.5A10 10 0 0 1 21.7 13.06A.75.75 0 1 1 20.25 13.43A8.5 8.5 0 0 0 3.75 13.43A.75.75 0 0 1 2.3 13.07A10 10 0 0 1 12 5.5</StreamGeometry>
        <StreamGeometry x:Key="IconPlugDisconnected">M21.7 3.7A1 1 0 0 0 20.3 2.3L18.5 4.09A4.25 4.25 0 0 0 13.24 4.69L12.18 5.76C11.49 6.45 11.49 7.56 12.18 8.24L15.76 11.82C16.45 12.51 17.56 12.51 18.24 11.82L19.31 10.76A4.25 4.25 0 0 0 19.91 5.5ZM10.7 11.7A1 1 0 0 0 9.3 10.3L7.82 11.76L7.53 11.47A.75.75 0 0 0 6.47 11.47L4.69 13.24A4.25 4.25 0 0 0 4.09 18.5L2.29 20.3A1 1 0 1 0 3.71 21.7L5.5 19.91A4.25 4.25 0 0 0 10.75 19.31L12.52 17.53C12.82 17.23 12.82 16.76 12.52 16.47L12.22 16.17L13.7 14.71A1 1 0 0 0 12.28 13.29L10.81 14.76L9.23 13.18Z</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M3 5.75C3 5.33579 3.33579 5 3.75 5C6.41341 5 9.00797 4.05652 11.55 2.15C11.8167 1.95 12.1833 1.95 12.45 2.15C14.992 4.05652 17.5866 5 20.25 5C20.6642 5 21 5.33579 21 5.75V11C21 16.0012 18.0424 19.6757 12.2749 21.9478C12.0982 22.0174 11.9018 22.0174 11.7251 21.9478C5.95756 19.6757 3 16.0012 3 11V5.75Z</StreamGeometry>
        <StreamGeometry x:Key="IconMonitor">M6.75 22.0004C6.33579 22.0004 6 21.6647 6 21.2504C6 20.8707 6.28215 20.557 6.64823 20.5073L6.75 20.5004L8.499 20.5V18.002L4.25 18.0023C3.05914 18.0023 2.08436 17.0771 2.00519 15.9063L2 15.7523V5.25C2 4.05914 2.92516 3.08436 4.09595 3.00519L4.25 3H19.7488C20.9397 3 21.9145 3.92516 21.9936 5.09595L21.9988 5.25V15.7523C21.9988 16.9431 21.0737 17.9179 19.9029 17.9971L19.7488 18.0023L15.499 18.002V20.5L17.25 20.5004C17.6642 20.5004 18 20.8362 18 21.2504C18 21.6301 17.7178 21.9439 17.3518 21.9936L17.25 22.0004H6.75ZM13.998 18.002H9.998L9.999 20.5004H13.999L13.998 18.002Z</StreamGeometry>
        <StreamGeometry x:Key="IconWifi">M17.78 10.7C18.38 11.3 18.9 12.03 19.28 12.8A1 1 0 0 1 17.51 13.7Q17.05 12.81 16.37 12.12A6.13 6.13 0 0 0 6.57 13.68A1 1 0 0 1 4.79 12.78Q5.36 11.63 6.29 10.71A8.13 8.13 0 0 1 17.78 10.7M15.74 13.7Q16.44 14.4 16.84 15.32A1 1 0 0 1 15 16.12A3.23 3.23 0 0 0 9.07 16.11A1 1 0 1 1 7.24 15.31Q7.64 14.4 8.34 13.7A5.23 5.23 0 0 1 15.74 13.7M20.42 8.3Q21.19 9.07 21.82 9.99A1 1 0 0 1 20.18 11.13Q19.65 10.35 19.01 9.71A9.92 9.92 0 0 0 3.82 11.12A1 1 0 0 1 2.18 9.98A11.92 11.92 0 0 1 20.42 8.3M13.06 16.44A1.5 1.5 0 1 1 10.94 18.56A1.5 1.5 0 0 1 13.06 16.44</StreamGeometry>
        <StreamGeometry x:Key="IconLayers">M13.3867 3.42476L19.7519 7.66821C20.2115 7.97456 20.3356 8.59543 20.0293 9.05496C19.956 9.16481 19.8618 9.25907 19.7519 9.33231L13.3867 13.5758C12.547 14.1356 11.453 14.1356 10.6132 13.5758L4.24807 9.33231C3.78854 9.02595 3.66437 8.40509 3.97072 7.94556C4.04396 7.8357 4.13822 7.74144 4.24807 7.66821L10.6132 3.42476C11.453 2.86492 12.547 2.86492 13.3867 3.42476ZM20.0256 12.1922C19.8772 12.4296 19.6806 12.6332 19.4486 12.7899L13.3987 16.8736C12.5535 17.4441 11.4465 17.4441 10.6013 16.8736L4.55142 12.7899C3.79043 12.2762 3.49533 11.3306 3.77229 10.5003L10.6132 15.0598C11.4005 15.5847 12.4112 15.6175 13.2264 15.1582L13.3867 15.0598L20.2271 10.4998C20.4088 11.0459 20.3545 11.666 20.0256 12.1922ZM20.0256 15.4422C19.8772 15.6796 19.6806 15.8832 19.4486 16.0399L13.3987 20.1236C12.5535 20.6941 11.4465 20.6941 10.6013 20.1236L4.55142 16.0399C3.79043 15.5262 3.49533 14.5806 3.77229 13.7503L10.6132 18.3098C11.4005 18.8347 12.4112 18.8675 13.2264 18.4082L13.3867 18.3098L20.2271 13.7498C20.4088 14.2959 20.3545 14.916 20.0256 15.4422Z</StreamGeometry>
        <StreamGeometry x:Key="IconLogs">M6 2H13.5L20 8.5V20A2 2 0 0 1 18 22H6A2 2 0 0 1 4 20V4A2 2 0 0 1 6 2ZM8.75 11.25H15.25A.75.75 0 0 1 15.25 12.75H8.75A.75.75 0 0 1 8.75 11.25ZM8.75 15.25H15.25A.75.75 0 0 1 15.25 16.75H8.75A.75.75 0 0 1 8.75 15.25ZM8.75 7.25H11.25A.75.75 0 0 1 11.25 8.75H8.75A.75.75 0 0 1 8.75 7.25Z</StreamGeometry>
        <StreamGeometry x:Key="IconRadar">M15.8432 17.3679C14.4988 18.392 12.8204 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11C19 12.8768 18.3537 14.6027 17.2715 15.9672L21.6982 20.2841C22.0936 20.6697 22.1015 21.3028 21.7159 21.6982C21.3303 22.0936 20.6972 22.1015 20.3018 21.7159L15.8432 17.3679ZM17 11C17 7.68629 14.3137 5 11 5C7.68629 5 5 7.68629 5 11C5 14.3137 7.68629 17 11 17C14.3137 17 17 14.3137 17 11Z</StreamGeometry>
        <StreamGeometry x:Key="IconAlertTriangle">M9.13841 3.70704C10.3662 1.43109 13.6314 1.43093 14.8591 3.70704L21.6023 16.209C22.7698 18.3741 21.2018 21.0016 18.7419 21.002H5.25462C2.79479 21.0016 1.22676 18.3741 2.39426 16.209L9.13841 3.70704ZM12.0007 15C11.4486 15.0002 11.0008 15.4479 11.0007 16C11.0007 16.5522 11.4486 16.9998 12.0007 17C12.5528 16.9998 13.0007 16.5522 13.0007 16C13.0006 15.4479 12.5528 15.0002 12.0007 15ZM12.0007 7.50001C11.5867 7.50019 11.2508 7.83598 11.2507 8.25001V12.75C11.2507 13.1641 11.5867 13.4998 12.0007 13.5C12.4148 13.4998 12.7507 13.1641 12.7507 12.75V8.25001C12.7506 7.83599 12.4147 7.50021 12.0007 7.50001Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ── Base Button Style ── -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary Action Button (Scan). Fluent's own filled accent button
             has no border — the outline was adding a second bright edge on
             top of the fill, which is what read as "sharp". -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryPressedBrush}"/>
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Danger/Action Button (Start Spoof) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource AccentDangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentDangerHoverBrush}"/>
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="Background" Value="{StaticResource AccentDangerPressedBrush}"/>
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Stop Spoof Active Button -->
        <Style Selector="Button.active-stop">
            <Setter Property="Background" Value="{StaticResource CardBackgroundElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.active-stop:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentDangerBgBrush}"/>
        </Style>

        <!-- ComboBox Dark Styling -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- NumericUpDown Dark Styling -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Custom ListBoxItem Style for Data Table -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="#262E38"/>
        </Style>
        <!-- Blocked rows: translucent tint of the Spoof/danger red so stripes and hover show through -->
        <Style Selector="ListBoxItem Border.blocked">
            <Setter Property="Background" Value="#2EB05345"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.blocked">
            <Setter Property="Background" Value="#5C322D"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B435C"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionHoverBrush}"/>
        </Style>

        <!-- CheckBox Styling for Spoof / Block -->
        <Style Selector="CheckBox.spoof-check:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox.block-check:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource AccentDangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDangerBrush}"/>
        </Style>

        <!-- ── Responsive scaling: Window.compact is toggled in code-behind
             (MainWindow.axaml.cs SizeChanged) below a width threshold, so
             text and spacing react to the actual window size instead of
             just clipping/wrapping at a fixed layout. ── -->
        <Style Selector="Window.compact TextBlock.app-title">
            <Setter Property="FontSize" Value="15.5"/>
        </Style>
        <Style Selector="Window.compact TextBlock.section-label">
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style Selector="Window.compact TextBlock.kpi-value">
            <Setter Property="FontSize" Value="16.5"/>
        </Style>
        <!-- Whitelist toggle: checked state uses the app's primary accent (same as Scan) -->
        <Style Selector="ToggleButton.wl-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.wl-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryHoverBrush}"/>
        </Style>
    </Application.Styles>
</Application>